PORT=3000
NODE_ENV=development
# Keep disabled unless the exact trusted proxy topology is known.
TRUST_PROXY=0
ALLOWED_ORIGINS=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=shopademia_app
DB_PASSWORD=replace_with_a_strong_application_password
DB_NAME=shopademia
DB_POOL_SIZE=10

# Used only by npm run migrate; keep this account separate from DB_USER.
DB_MIGRATION_USER=shopademia_migrator
DB_MIGRATION_PASSWORD=replace_with_a_strong_migration_password

# Generate distinct random secrets of at least 32 characters; never reuse them.
ADMIN_JWT_SECRET=replace_with_a_random_admin_signing_secret_at_least_32_chars
CUSTOMER_JWT_SECRET=replace_with_a_different_customer_signing_secret_at_least_32_chars
ADMIN_ACCESS_TOKEN_TTL_SECONDS=900
CUSTOMER_ACCESS_TOKEN_TTL_SECONDS=900

# Used only by npm run admin:create; never commit a real .env.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
