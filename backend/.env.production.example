PORT=3000
NODE_ENV=production
# Keep disabled unless the exact trusted proxy topology is known.
TRUST_PROXY=0
ALLOWED_ORIGINS=https://store.example.com
DB_HOST=database.internal
DB_PORT=3306
DB_USER=shopademia_app
DB_PASSWORD=<set-out-of-band>
DB_NAME=shopademia
DB_POOL_SIZE=10
DB_MIGRATION_USER=shopademia_migrator
DB_MIGRATION_PASSWORD=<set-out-of-band>
ADMIN_JWT_SECRET=<generate-a-unique-random-secret-at-least-32-bytes>
CUSTOMER_JWT_SECRET=<generate-a-different-unique-random-secret-at-least-32-bytes>
ADMIN_ACCESS_TOKEN_TTL_SECONDS=900
CUSTOMER_ACCESS_TOKEN_TTL_SECONDS=900
